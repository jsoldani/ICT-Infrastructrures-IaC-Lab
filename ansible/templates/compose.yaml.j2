services:
  api:
    build:
      context: {{ project_dir }}/app
    image: {{ app_image }}
    environment:
      APP_MESSAGE: "{{ app_message }}"
    networks:
      - lab
    restart: unless-stopped

  web:
    image: nginx:1.27-alpine
    ports:
      - "{{ host_port }}:80"
    volumes:
      - {{ project_dir }}/app/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - api
    networks:
      - lab
    restart: unless-stopped

networks:
  lab:
    name: {{ network_name }}
    external: true
